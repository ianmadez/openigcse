# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_ENV=development

# Parent area. The PIN unlocks /parent; change it before anyone else uses this.
PARENT_MASTER_PIN=1234

# Signs the parent-area gate cookie. Defaults to SUPABASE_SERVICE_ROLE_KEY when unset;
# set a stable value of your own so rotating the service key does not unlock every device.
PARENT_GATE_SECRET=

# `pnpm test:rls` checks a real learner session when these are set.
RLS_TEST_STUDENT_EMAIL=
RLS_TEST_STUDENT_PASSWORD=

# Required by POST /api/curriculum/import (sent as the x-admin-token header).
CURRICULUM_IMPORT_TOKEN=

# Skip the onboarding gate on this device while you are still building.
# Set to false (or delete) once /parent/onboarding has been completed.
ONBOARDING_BYPASS=false

# Screenshot-only demo workspace for /today. Leave unset for real data.
# Nothing else reads Postgres through it, and no screen falls back to it silently.
DEMO_MODE=

# Shown in the demo workspace when no learner exists yet. Never required.
DEMO_STUDENT_NAME=
DEMO_STAGE=
DEMO_EXAM_SERIES=
# Web Push (Phase 5.3): generate with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@openigcse.app
