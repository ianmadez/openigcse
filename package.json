{
  "name": "openigcse",
  "version": "0.1.0",
  "private": true,
  "description": "OpenIGCSE - an offline-first IGCSE study workspace for Form 2 learners and their parents.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-packages.ts",
    "fetch:syllabuses": "tsx scripts/fetch-syllabuses.ts",
    "ingest": "tsx scripts/ingest-syllabus.ts",
    "ingest:list": "tsx scripts/ingest-syllabus.ts --list",
    "sync:packages": "tsx scripts/sync-package-manifests.ts",
    "test:parser": "tsx --test scripts/lib/syllabusParser.test.ts",
    "test:rls": "tsx scripts/verify-rls.ts",
    "check:contrast": "node scripts/check-contrast.mjs",
    "import": "tsx scripts/import-package.ts",
    "verify:phase3": "tsx scripts/verify-phase3.ts",
    "test:unit": "tsx --test src/lib/assessment/scoring.test.ts src/lib/assessment/question.test.ts src/lib/assessment/builder.test.ts src/lib/assessment/sitting.test.ts src/lib/assessment/marking.test.ts src/lib/assessment/evidence.test.ts src/lib/planning/series.test.ts src/lib/storage/rules.test.ts",
    "dev:household": "tsx scripts/dev-household.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.118.0",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "cuelume": "^0.2.8",
    "katex": "0.16.22",
    "lucide-react": "^0.469.0",
    "next": "15.5.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "pdfjs-dist": "^6.4.299",
    "playwright": "1.60.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
